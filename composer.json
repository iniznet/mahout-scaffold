{
    "name": "iniznet/mahout-scaffold",
    "description": "The mahout CLI: generates a theme from its stub trees and then has no presence in the theme it produced.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "mahout",
        "scaffold",
        "generator",
        "cli"
    ],
    "bin": [
        "bin/mahout"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/iniznet/mahout-devtools.git"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "iniznet/mahout-devtools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Iniznet\\Mahout\\Scaffold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Iniznet\\Mahout\\Scaffold\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "scripts": {
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=2G",
        "psalm": "psalm --taint-analysis --no-cache",
        "arch": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=2G",
        "rector": "rector --dry-run --no-progress-bar",
        "test": "php vendor/bin/phpunit -c phpunit.xml.dist",
        "accept": [
            "@putenv MAHOUT_SCAFFOLD_E2E=all",
            "php vendor/bin/phpunit -c phpunit.xml.dist --filter GenerationAcceptanceTest"
        ],
        "hooks:check": "php vendor/bin/mahout-devtools hooks:check --source=src --output=docs/reference/hooks.md",
        "hooks:generate": "php vendor/bin/mahout-devtools hooks:generate --source=src --output=docs/reference/hooks.md",
        "i18n:check": "php vendor/bin/mahout-devtools i18n:check --domain=mahout-scaffold --source=src --output=languages/mahout-scaffold.pot",
        "i18n:generate": "php vendor/bin/mahout-devtools i18n:generate --domain=mahout-scaffold --source=src --output=languages/mahout-scaffold.pot",
        "doctor": "php vendor/bin/mahout-devtools doctor",
        "config:check": "php vendor/bin/mahout-devtools config:check",
        "check": [
            "@format:check",
            "@stan",
            "@psalm",
            "@rector",
            "@test",
            "@hooks:check",
            "@i18n:check",
            "@doctor",
            "@config:check"
        ]
    },
    "extra": {},
    "minimum-stability": "dev",
    "prefer-stable": true
}
