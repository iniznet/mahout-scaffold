{
    "name": "iniznet/howdah",
    "description": "A mahout starter theme.",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "mahout",
        "theme",
        "howdah"
    ],
    "repositories": [
        { "type": "vcs", "url": "https://github.com/iniznet/mahout-kernel.git" },
        { "type": "vcs", "url": "https://github.com/iniznet/mahout-assets.git" },
        { "type": "vcs", "url": "https://github.com/iniznet/mahout-content.git" },
        { "type": "vcs", "url": "https://github.com/iniznet/mahout-fields.git" },
        { "type": "vcs", "url": "https://github.com/iniznet/mahout-db.git" }
    ],
    "require": {
        "php": ">=8.4",
        "iniznet/mahout-kernel": "^1.0",
        "iniznet/mahout-assets": "^1.0",
        "iniznet/mahout-content": "^1.0",
        "iniznet/mahout-fields": "^1.0",
        "iniznet/mahout-db": "^1.0",
        "iniznet/mahout-ui": "^1.0"
    },
    "require-dev": {
        "iniznet/mahout-devtools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Iniznet\\Howdah\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Iniznet\\Howdah\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "allow-plugins": {}
    },
    "scripts": {
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=2G",
        "psalm": "psalm --taint-analysis --no-cache",
        "arch": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=2G",
        "rector": "rector --dry-run --no-progress-bar",
        "test": "php vendor/bin/phpunit -c phpunit.xml.dist",
        "hooks:check": "php vendor/bin/mahout-devtools hooks:check --source=app --output=docs/reference/hooks.md",
        "hooks:generate": "php vendor/bin/mahout-devtools hooks:generate --source=app --output=docs/reference/hooks.md",
        "i18n:check": "php vendor/bin/mahout-devtools i18n:check --domain=howdah --source=app --output=languages/howdah.pot",
        "i18n:generate": "php vendor/bin/mahout-devtools i18n:generate --domain=howdah --source=app --output=languages/howdah.pot",
        "doctor": "php vendor/bin/mahout-devtools doctor",
        "config:check": "php vendor/bin/mahout-devtools config:check",
        "check": [
            "@format:check",
            "@stan",
            "@psalm",
            "@rector",
            "@test",
            "@hooks:check",
            "@i18n:check",
            "@doctor",
            "@config:check"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
